# Copie ces noms dans Vercel > Settings > Environment Variables (jamais de vraies valeurs dans Git)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MOMO_NUMERO=
NEXT_PUBLIC_MOMO_NOM=
NEXT_PUBLIC_NOM_BOUTIQUE=

# --- Admin ---
ADMIN_PASSWORD=
# Longue chaîne aléatoire (ex. : openssl rand -hex 32). Sert à signer la session.
ADMIN_SESSION_SECRET=
# Adresse publique du site, sans / final (sert au lien de suivi dans les messages)
NEXT_PUBLIC_SITE_URL=
# Numéro de paiement affiché dans les messages de devis (déjà utilisé par le formulaire)
NEXT_PUBLIC_WAVE_NUMERO=
